#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="$(readlink -f "$0" 2>/dev/null || realpath "$0" 2>/dev/null || echo "$0")"
SCRIPT_DIR="$(dirname "$SCRIPT_PATH")"
DEQUL_HOME="${DEQUL_HOME:-$SCRIPT_DIR}"
COMPOSE_FILE="$DEQUL_HOME/docker-compose.yml"
[ -f "$DEQUL_HOME/.env" ] && set -a && . "$DEQUL_HOME/.env" && set +a
INSTALLED_VERSION="$(cat "$DEQUL_HOME/VERSION" 2>/dev/null || echo "0.1.0")"
export DEQUL_VERSION="$INSTALLED_VERSION"

BOLD='\033[1m'
DIM='\033[2m'
GREEN='\033[0;32m'
AMBER='\033[0;33m'
RED='\033[0;31m'
NC='\033[0m'

header()  { printf "\n${BOLD}${AMBER}==>${NC}${BOLD} %s${NC}\n" "$*"; }
info()    { printf "  ${DIM}%s${NC}\n" "$*"; }
success() { printf "  ${GREEN}✓${NC} %s\n" "$*"; }
warn()    { printf "  ${AMBER}⚠${NC} %s\n" "$*"; }
fail()    { printf "  ${RED}✗${NC} %s\n" "$*"; exit 1; }

ensure_encryption_key() {
	[ -n "${ENV_ENCRYPTION_KEY:-}" ] && return 0
	local key=""
	if [ -f "$DEQUL_HOME/data/dequl.json" ]; then
		key="$(sed -n 's/^.*"ENV_ENCRYPTION_KEY"[[:space:]]*:[[:space:]]*"\([^"]*\)".*$/\1/p' "$DEQUL_HOME/data/dequl.json" | head -n1)"
	fi
	if [ -z "$key" ]; then
		key="$(openssl rand -hex 32 2>/dev/null || dd if=/dev/urandom bs=32 count=1 status=none 2>/dev/null | od -A n -t x1 | tr -d ' \n')"
	fi
	[ -n "$key" ] || fail "Cannot generate encryption key"
	export ENV_ENCRYPTION_KEY="$key"
	local env_file="$DEQUL_HOME/.env"
	if [ ! -f "$env_file" ]; then
		printf '# Dequl environment configuration\n' > "$env_file"
		chmod 600 "$env_file"
	fi
	if ! grep -q '^ENV_ENCRYPTION_KEY=..*' "$env_file" 2>/dev/null; then
		sed -i '/^ENV_ENCRYPTION_KEY=/d' "$env_file" 2>/dev/null || true
		echo "ENV_ENCRYPTION_KEY=$key" >> "$env_file"
	fi
	chmod 600 "$env_file" 2>/dev/null || true
}
ensure_encryption_key

cmd() {
	if [ ! -f "$COMPOSE_FILE" ]; then
		fail "Dequl not found at $DEQUL_HOME. Run install.sh first or set \$DEQUL_HOME."
	fi
	docker compose -f "$COMPOSE_FILE" "$@"
}

cmd_start() {
	header "Starting Dequl"
	cmd up -d
	local domain="${CADDY_BASE_DOMAIN:-localhost}"
	if [ "$domain" = "localhost" ]; then
		success "Dequl is running at http://localhost"
	else
		success "Dequl is running at https://$domain"
	fi
}

cmd_stop() {
	header "Stopping Dequl"
	cmd down
	success "Dequl stopped."
}

cmd_restart() {
	header "Restarting Dequl"
	cmd restart
	success "Dequl restarted."
}

cmd_status() {
	cmd ps --format "table {{.Name}}\t{{.Status}}\t{{.Ports}}"
}

cmd_logs() {
	shift
	cmd logs -f "$@"
}

cmd_update() {
	header "Updating Dequl"

	local repo="Lftobs/dequl"
	local tag=""
	local base_url=""
	local target_arg="${2:-}"

	if [ "$target_arg" = "--pre" ] || [ "$target_arg" = "--prerelease" ]; then
		info "Checking for latest pre-release..."
		tag=$(curl -fsSL "https://api.github.com/repos/$repo/releases" \
			| grep '"tag_name"' | head -1 | sed -E 's/.*"([^"]+)".*/\1/') || true
	elif [ "$target_arg" = "--rc" ]; then
		info "Checking for latest release candidate..."
		tag=$(curl -fsSL "https://api.github.com/repos/$repo/releases" \
			| grep '"tag_name"' | grep -E 'rc[0-9]+$' | head -1 | sed -E 's/.*"([^"]+)".*/\1/') || true
		if [ -z "$tag" ]; then
			fail "No release candidate found"
		fi
	elif [ -n "$target_arg" ] && [ "$target_arg" != "latest" ]; then
		if [[ "$target_arg" == v* ]]; then
			tag="$target_arg"
		else
			tag="v$target_arg"
		fi
	else
		info "Checking for latest stable release..."
		tag=$(curl -fsSL "https://api.github.com/repos/$repo/releases/latest" \
			| grep '"tag_name"' | head -1 | sed -E 's/.*"([^"]+)".*/\1/') || true
	fi

	if [ -z "$tag" ]; then
		warn "Could not determine release, using main branch"
		base_url="https://raw.githubusercontent.com/$repo/main"
	else
		base_url="https://raw.githubusercontent.com/$repo/$tag"
		success "Target release: $tag"
	fi

	local current_version
	current_version="$(cat "$DEQUL_HOME/VERSION" 2>/dev/null || echo "unknown")"

	local tmp_dir
	tmp_dir=$(mktemp -d)
	# shellcheck disable=SC2064
	trap "rm -rf '$tmp_dir'" EXIT

	info "Downloading updated configuration..."
	curl -fsSL "$base_url/docker-compose.yml" -o "$tmp_dir/docker-compose.yml" || fail "Failed to download docker-compose.yml"
	curl -fsSL "$base_url/infra/caddy/Caddyfile" -o "$tmp_dir/Caddyfile" || fail "Failed to download Caddyfile"
	curl -fsSL "$base_url/scripts/dequl" -o "$tmp_dir/dequl" || fail "Failed to download dequl CLI"
	curl -fsSL "$base_url/scripts/firewall-setup.sh" -o "$tmp_dir/firewall-setup.sh" 2>/dev/null || true
	curl -fsSL "$base_url/VERSION" -o "$tmp_dir/VERSION" 2>/dev/null || echo "${tag#v}" > "$tmp_dir/VERSION"

	mkdir -p "$tmp_dir/infra/monitoring/grafana/datasources" \
		"$tmp_dir/infra/monitoring/grafana/dashboards" \
		"$tmp_dir/scripts/auth"

	for f in prometheus.yml loki-config.yml promtail-config.yml; do
		curl -fsSL "$base_url/infra/monitoring/$f" -o "$tmp_dir/infra/monitoring/$f" 2>/dev/null || true
	done

	for f in loki.yml prometheus.yml; do
		curl -fsSL "$base_url/infra/monitoring/grafana/datasources/$f" -o "$tmp_dir/infra/monitoring/grafana/datasources/$f" 2>/dev/null || true
	done

	for f in dashboards.yml deployed-apps.json; do
		curl -fsSL "$base_url/infra/monitoring/grafana/dashboards/$f" -o "$tmp_dir/infra/monitoring/grafana/dashboards/$f" 2>/dev/null || true
	done

	for f in pam-server.py pam-verify.py; do
		curl -fsSL "$base_url/scripts/auth/$f" -o "$tmp_dir/scripts/auth/$f" 2>/dev/null || true
	done

	local resolved_tag="${tag#v}"
	if [ -z "$resolved_tag" ] || [ "$resolved_tag" = "main" ]; then
		resolved_tag="latest"
	fi

	python3 -c "
import re, sys
with open('$tmp_dir/docker-compose.yml', 'r') as f:
    content = f.read()
content = re.sub(r'ghcr\.io/lftobs/dequl/api:\w+', 'ghcr.io/lftobs/dequl/api:$resolved_tag', content)
content = re.sub(r'ghcr\.io/lftobs/dequl/web:\w+', 'ghcr.io/lftobs/dequl/web:$resolved_tag', content)
content = re.sub(r'#\s*(image:\s*ghcr\.io/lftobs/dequl/)', r'\1', content)
content = re.sub(r'([ \t]+)build:\s*\n\s+context:\s*(?:\.|\./apps/api)\s*\n\s+dockerfile:\s*\S+', r'\1# build:\n\1#     context: ./apps/api\n\1#     dockerfile: Dockerfile', content)
content = re.sub(r'([ \t]+)build:\s*\n\s+context:\s*\./apps/web(?:\s*\n\s+args:\s*\n\s+DEQUL_VERSION:\s*\S+)?', r'\1# build:\n\1#     context: ./apps/web\n\1#     args:\n\1#         DEQUL_VERSION: \${DEQUL_VERSION:-}', content)
with open('$tmp_dir/docker-compose.yml', 'w') as f:
    f.write(content)
" 2>/dev/null || true

	mkdir -p "$DEQUL_HOME/infra/caddy" \
		"$DEQUL_HOME/infra/monitoring/grafana/datasources" \
		"$DEQUL_HOME/infra/monitoring/grafana/dashboards" \
		"$DEQUL_HOME/scripts/auth"

	mv "$tmp_dir/docker-compose.yml" "$DEQUL_HOME/docker-compose.yml"
	mv "$tmp_dir/Caddyfile" "$DEQUL_HOME/infra/caddy/Caddyfile"

	for f in prometheus.yml loki-config.yml promtail-config.yml; do
		[ -f "$tmp_dir/infra/monitoring/$f" ] && mv "$tmp_dir/infra/monitoring/$f" "$DEQUL_HOME/infra/monitoring/$f"
	done
	for f in loki.yml prometheus.yml; do
		[ -f "$tmp_dir/infra/monitoring/grafana/datasources/$f" ] && mv "$tmp_dir/infra/monitoring/grafana/datasources/$f" "$DEQUL_HOME/infra/monitoring/grafana/datasources/$f"
	done
	for f in dashboards.yml deployed-apps.json; do
		[ -f "$tmp_dir/infra/monitoring/grafana/dashboards/$f" ] && mv "$tmp_dir/infra/monitoring/grafana/dashboards/$f" "$DEQUL_HOME/infra/monitoring/grafana/dashboards/$f"
	done
	for f in pam-server.py pam-verify.py; do
		[ -f "$tmp_dir/scripts/auth/$f" ] && mv "$tmp_dir/scripts/auth/$f" "$DEQUL_HOME/scripts/auth/$f"
	done
	if [ -f "$tmp_dir/firewall-setup.sh" ]; then
		mkdir -p "$DEQUL_HOME/scripts"
		mv "$tmp_dir/firewall-setup.sh" "$DEQUL_HOME/scripts/firewall-setup.sh"
		chmod +x "$DEQUL_HOME/scripts/firewall-setup.sh" 2>/dev/null || true
	fi

	mv "$tmp_dir/VERSION" "$DEQUL_HOME/VERSION"
	chmod +x "$tmp_dir/dequl"
	mv "$tmp_dir/dequl" "$SCRIPT_PATH"

	success "Configuration updated"

	header "Pulling new images"
	cmd pull

	header "Rolling restart (zero downtime)"
	cmd up -d --remove-orphans --force-recreate api web 2>/dev/null || cmd up -d

	cmd exec -T caddy caddy reload --config /etc/caddy/Caddyfile 2>/dev/null || true

	info "Waiting for services to become healthy..."
	local retries=0
	local max_retries=30
	while [ $retries -lt $max_retries ]; do
		if curl -fs http://localhost/api/health >/dev/null 2>&1; then
			break
		fi
		retries=$((retries + 1))
		sleep 2
	done

	if [ $retries -ge $max_retries ]; then
		warn "API did not become healthy within ${max_retries}x2s — check logs with 'dequl logs api'"
		warn "To rollback: dequl update v${current_version#v}"
	else
		success "Dequl updated to ${tag:-main} (was ${current_version})"
	fi
}

cmd_uninstall() {
	echo ""
	echo "${BOLD}${RED}⚠  Dequl Uninstall${NC}"
	echo ""
	echo "  This will permanently remove:"
	echo ""
	[ -d "$DEQUL_HOME" ] && echo "  • Config directory: $DEQUL_HOME"
	[ -L "/usr/local/bin/dequl" ] && echo "  • CLI symlink: /usr/local/bin/dequl"
	echo "  • Docker Compose stack (services + networks)"
	echo "  • Docker named volumes (buildkit, redis, prometheus, loki, grafana data)"
	echo "  • Docker images (ghcr.io/lftobs/dequl/api, ghcr.io/lftobs/dequl/web)"
	echo ""
	echo "  ${BOLD}Your deployed projects will lose their observability stack.${NC}"
	echo ""
	read -r -p "  ${BOLD}${RED}Are you sure?${NC} Type 'yes' to confirm: " CONFIRM

	if [ "$CONFIRM" != "yes" ]; then
		echo ""
		info "Uninstall cancelled."
		exit 0
	fi

	if [ -f "$COMPOSE_FILE" ]; then
		header "Stopping services"
		docker compose -f "$COMPOSE_FILE" down -v || true
		success "Services stopped and volumes removed."
	fi

	header "Removing Docker images"
	docker rmi -f ghcr.io/lftobs/dequl/api:latest ghcr.io/lftobs/dequl/web:latest 2>/dev/null || true
	success "Images removed."

	if [ -d "$DEQUL_HOME" ]; then
		header "Removing config directory"
		rm -rf "$DEQUL_HOME"
		success "Removed $DEQUL_HOME"
	fi

	if [ -L "/usr/local/bin/dequl" ]; then
		header "Removing CLI symlink"
		rm -f /usr/local/bin/dequl
		success "Removed /usr/local/bin/dequl"
	fi

	echo ""
	success "${BOLD}Dequl uninstalled.${NC}"
	echo ""
	info "Docker Engine and Docker Compose were left untouched."
	echo ""
}

cmd_version() {
	echo "dequl v$INSTALLED_VERSION"
}

cmd_backup() {
	header "Creating backup"
	
	local target="${1:-internal}"
	local api_url="${DEQUL_API_URL:-http://localhost:3001}"
	
	info "Backing up target: $target"
	
	local response
	response=$(curl -s -X POST "$api_url/api/backups/$target/trigger" \
		-H "Content-Type: application/json" \
		-w "\n%{http_code}" 2>&1)
	
	local http_code
	http_code=$(echo "$response" | tail -n1)
	local body
	body=$(echo "$response" | sed '$d')
	
	if [ "$http_code" = "201" ] || [ "$http_code" = "200" ]; then
		success "Backup started: $(echo "$body" | grep -o '"id":"[^"]*"' | head -1 | cut -d'"' -f4)"
	else
		fail "Backup failed: $body"
	fi
}

cmd_backup_list() {
	header "Listing backups"
	
	local api_url="${DEQUL_API_URL:-http://localhost:3001}"
	local response
	response=$(curl -s "$api_url/api/backups" 2>&1)
	
	echo "$response" | python3 -m json.tool 2>/dev/null || echo "$response"
}

cmd_backup_restore() {
	local backup_id="${1:-}"
	if [ -z "$backup_id" ]; then
		fail "Usage: dequl backup restore <backup-id>"
	fi
	
	header "Restoring from backup: $backup_id"
	
	local api_url="${DEQUL_API_URL:-http://localhost:3001}"
	local response
	response=$(curl -s -X POST "$api_url/api/backups/$backup_id/restore" \
		-H "Content-Type: application/json" \
		-w "\n%{http_code}" 2>&1)
	
	local http_code
	http_code=$(echo "$response" | tail -n1)
	local body
	body=$(echo "$response" | sed '$d')
	
	if [ "$http_code" = "200" ]; then
		success "Restore completed."
	else
		fail "Restore failed: $body"
	fi
}

cmd_help() {
	echo "Dequl - Self-hosted deployment platform"
	echo ""
	echo "Usage: dequl <command>"
	echo ""
	echo "Commands:"
	echo "  start             Start all Dequl services"
	echo "  stop              Stop all Dequl services"
	echo "  restart           Restart all Dequl services"
	echo "  status            Show service status"
	echo "  logs              Follow service logs"
	echo "  update            Update Dequl (zero-downtime rolling restart)"
	echo "  backup            Create a backup of the database"
	echo "  backup list       List all backups"
	echo "  backup restore    Restore from a backup"
	echo "  firewall          Manage host firewall (status, setup)"
	echo "  uninstall         Remove Dequl completely (config, images, volumes)"
	echo "  --version         Show version"
	echo "  --help            Show this help"
	echo ""
	echo "Backup commands:"
	echo "  dequl backup                  Backup internal database"
	echo "  dequl backup <db-id>          Backup a specific managed database"
	echo "  dequl backup list             List all backups"
	echo "  dequl backup restore <id>     Restore from a backup"
	echo ""
	echo "Update options:"
	echo "  dequl update                 Update to latest stable release"
	echo "  dequl update latest          Update to latest stable release"
	echo "  dequl update --pre           Update to latest pre-release"
	echo "  dequl update --rc            Update to latest release candidate"
	echo "  dequl update v0.3.0-rc.8     Update to specific version"
	echo "  dequl update v1.0.0          Update to specific version"
	echo ""
	echo "Environment:"
	echo "  DEQUL_HOME  Config directory (default: auto-detected from install path)"
}

cmd_firewall() {
	shift
	local script="$DEQUL_HOME/scripts/firewall-setup.sh"
	if [ ! -f "$script" ]; then
		script="$(dirname "$SCRIPT_PATH")/firewall-setup.sh"
	fi
	if [ -f "$script" ]; then
		bash "$script" "$@"
	else
		fail "firewall-setup.sh not found."
	fi
}

case "${1:-}" in
	start)    cmd_start ;;
	stop)     cmd_stop ;;
	restart)  cmd_restart ;;
	status)   cmd_status ;;
	logs)     cmd_logs "$@" ;;
	update)   cmd_update "$@" ;;
	firewall) cmd_firewall "$@" ;;
	backup)
		shift
		case "${1:-}" in
			list)     cmd_backup_list ;;
			restore)  shift; cmd_backup_restore "$@" ;;
			*)        cmd_backup "${1:-internal}" ;;
		esac
		;;
	uninstall) cmd_uninstall ;;
	--version|-v) cmd_version ;;
	--help|-h|"") cmd_help ;;
	*)        fail "Unknown command: $1. Run 'dequl --help' for usage." ;;
esac
