---
interface MarkdownFile {
  frontmatter: {
    title?: string;
    date?: string;
    changelog?: {
      version?: string;
      category?: string;
    };
    description?: string;
  };
  Content: any;
  file: string;
}

const changelogModules = import.meta.glob<MarkdownFile>("../docs/changelogs/*.md", { eager: true });

const releases = Object.entries(changelogModules)
  .map(([path, mod]) => {
    const filename = path.split("/").pop()?.replace(".md", "") || "";
    const version = mod.frontmatter.title || (mod.frontmatter.changelog?.version ? `v${mod.frontmatter.changelog.version}` : filename);
    const date = mod.frontmatter.date || "";
    const description = mod.frontmatter.description || "";
    const formattedDate = date
      ? new Date(date).toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })
      : "";
    return {
      version,
      date,
      formattedDate,
      description,
      Content: mod.Content,
    };
  })
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

const latestVersion = releases[0]?.version || "v0.4.0";
const latestDate = releases[0]?.formattedDate || "";
---

<div class="release-viewer not-prose my-6">
  <div class="release-toolbar flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 p-4 rounded-xl border border-[#222228] bg-[#0e0e12]/90 backdrop-blur-sm">
    <div class="flex items-center gap-3">
      <label for="release-version-select" class="text-xs font-mono font-semibold uppercase tracking-wider text-[#a1a1aa]">
        Version
      </label>
      <div class="relative inline-block">
        <select
          id="release-version-select"
          class="appearance-none bg-[#141418] border border-[#2a2a32] hover:border-[#ea580c]/50 focus:border-[#ea580c] text-white font-mono text-sm rounded-lg px-3.5 py-2 pr-9 cursor-pointer outline-none transition-all shadow-sm"
        >
          {releases.map((rel, idx) => (
            <option value={rel.version} selected={idx === 0}>
              {rel.version} {idx === 0 ? "(Latest)" : ""}
            </option>
          ))}
        </select>
        <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2.5 text-[#71717a]">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </div>
      </div>
    </div>

    <div class="flex items-center gap-2.5 text-xs text-[#71717a] font-mono">
      <span id="release-meta-date" class="inline-flex items-center px-2.5 py-1 rounded-md bg-[#16161c] border border-[#26262e] text-[#d4d4d8]">
        {latestDate}
      </span>
      <a
        id="release-meta-gh"
        href={`https://github.com/Lftobs/dequel/releases/tag/${latestVersion}`}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1 px-2.5 py-1 rounded-md bg-[#16161c] border border-[#26262e] text-[#ea580c] hover:bg-[#1f1f26] transition-colors"
      >
        <span>GitHub Release</span>
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
    </div>
  </div>
</div>

<div class="release-panels">
  {releases.map((rel, idx) => (
    <article
      class="release-version-article"
      data-release-version={rel.version}
      data-release-date={rel.formattedDate}
      style={idx === 0 ? "display: block;" : "display: none;"}
    >
      <rel.Content />
    </article>
  ))}
</div>

<script>
  function updateReleaseView(version: string) {
    const articles = document.querySelectorAll<HTMLElement>(".release-version-article");
    if (!articles.length) return;

    let targetArticle: HTMLElement | null = null;
    articles.forEach((art) => {
      const artVer = art.getAttribute("data-release-version");
      if (artVer === version) {
        targetArticle = art;
      }
    });

    if (!targetArticle && articles[0]) {
      targetArticle = articles[0];
      version = targetArticle.getAttribute("data-release-version") || version;
    }

    const select = document.getElementById("release-version-select") as HTMLSelectElement | null;
    if (select && select.value !== version) {
      select.value = version;
    }

    articles.forEach((art) => {
      const isMatch = art === targetArticle;
      art.style.display = isMatch ? "block" : "none";
    });

    if (targetArticle) {
      const targetDate = (targetArticle as HTMLElement).getAttribute("data-release-date") || "";
      const dateEl = document.getElementById("release-meta-date");
      if (dateEl && targetDate) {
        dateEl.textContent = targetDate;
      }
    }

    const ghLink = document.getElementById("release-meta-gh") as HTMLAnchorElement | null;
    if (ghLink) {
      ghLink.href = `https://github.com/Lftobs/dequel/releases/tag/${version}`;
    }
  }

  function setupReleaseViewer() {
    const select = document.getElementById("release-version-select") as HTMLSelectElement | null;
    if (!select) return;

    const params = new URLSearchParams(window.location.search);
    const hash = window.location.hash.replace("#", "");
    const initial = params.get("v") || hash || select.value;

    updateReleaseView(initial);

    select.addEventListener("change", (e) => {
      const newVer = (e.target as HTMLSelectElement).value;
      updateReleaseView(newVer);
      const url = new URL(window.location.href);
      url.searchParams.set("v", newVer);
      window.history.replaceState({}, "", url.toString());
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupReleaseViewer);
  } else {
    setupReleaseViewer();
  }
  document.addEventListener("astro:page-load", setupReleaseViewer);
</script>
