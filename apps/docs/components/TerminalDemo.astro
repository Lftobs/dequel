---
---

<section class="max-w-[1150px] mx-auto px-4 py-20 dq-reveal" id="demo">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
    <div class="lg:col-span-5 space-y-4">
      <div class="text-[0.65rem] font-bold uppercase tracking-[0.12em] text-[#ea580c]">Developer Experience</div>
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight leading-tight text-[#e2e2e8]">
        From git push to production<br />
        <span class="text-[#ea580c]">in under 4 seconds.</span>
      </h2>
      <p class="text-xs md:text-sm text-[#7f7f8a] leading-relaxed">
        Connect your project, run <code class="text-[#ea580c] bg-[#111114] px-1.5 py-0.5 rounded font-mono">dequel deploy</code>, and watch Dequel handle the rest — building your container via Buildkit, reloaded Caddy dynamic proxy, automated SSL issuance, and live status reporting.
      </p>
      <div class="pt-2 flex items-center gap-4 text-xs font-mono text-[#7f7f8a]">
        <div class="flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-green-500"></span>
          <span>Zero Downtime</span>
        </div>
        <div class="flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-amber-400"></span>
          <span>Auto Certs</span>
        </div>
      </div>
    </div>

    <!-- Dark Terminal Box -->
    <div class="lg:col-span-7 border border-[#222228] bg-[#000000] rounded-2xl overflow-hidden shadow-2xl" id="terminal-demo">
      <div class="flex items-center justify-between px-4 py-3 bg-[#111114] border-b border-[#151519]">
        <div class="flex items-center gap-2">
          <span class="w-3 h-3 rounded-full bg-red-500 inline-block"></span>
          <span class="w-3 h-3 rounded-full bg-yellow-500 inline-block"></span>
          <span class="w-3 h-3 rounded-full bg-green-500 inline-block"></span>
        </div>
        <span class="text-xs font-mono text-[#7f7f8a]">dequel cli v1.0.0</span>
        <span class="text-[0.65rem] font-mono text-[#4b4b54] bg-[#000000] px-2 py-0.5 rounded">bash</span>
      </div>
      <div class="p-6 font-mono text-xs md:text-sm leading-relaxed min-h-[220px]" id="terminal-output">
        <div>
          <span class="text-[#ea580c]">$ </span>
          <span class="text-[#e2e2e8]" id="t-line-0"></span>
          <span class="inline-block w-2 h-4 bg-[#ea580c] align-middle animate-pulse" id="t-cursor"></span>
        </div>
      </div>
    </div>
  </div>
</section>
