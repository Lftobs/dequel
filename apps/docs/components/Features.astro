---
const tabs = [
  {
    id: "build",
    label: "Git & Build Engine",
    icon: `<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>`,
    title: "Railpack Compilation & BuildKit Daemon",
    description: "Push code directly from GitHub or upload a project ZIP file. Dequel's internal Railpack CLI autodetects Node.js, Python, Go, Rust, and Dockerfiles, compiling zero-config production containers via BuildKit.",
    highlights: [
      "Automatic framework detection (Next.js, Express, Fastify, FastAPI, Go, etc.)",
      "Layer-cached builds with isolated workspace staging",
      "Instant rollback to previous container SHA hashes",
      "Custom environment variable injection & secret encryption"
    ],
    codePreview: `// dequel.config.json (Optional)
{
  "name": "my-api-service",
  "build": {
    "builder": "railpack",
    "env": {
      "NODE_ENV": "production"
    }
  },
  "routes": [
    { "domain": "api.mydomain.com", "port": 3001 }
  ]
}`
  },
  {
    id: "ingress",
    label: "Dynamic Ingress & Auto SSL",
    icon: `<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>`,
    title: "Caddy Ingress & Free Let's Encrypt Certificates",
    description: "Every deployed container is instantly routed through an internal high-performance Caddy reverse proxy. Dynamic route files are updated in real-time with zero server reboots.",
    highlights: [
      "Automatic SSL certificate issuance & renewal via Let's Encrypt",
      "Wildcard subdomains & custom apex domain attachments",
      "HTTP/2 and HTTP/3 QUIC protocol support out-of-the-box",
      "Zero-downtime dynamic routing reloading"
    ],
    codePreview: `# Dynamic Caddyfile (Auto-generated by Dequel)
api.mydomain.com {
  tls admin@mydomain.com
  reverse_proxy 10.0.0.12:3001 {
    header_up Host {host}
    header_up X-Real-IP {remote}
  }
}`
  },
  {
    id: "observability",
    label: "Observability Stack",
    icon: `<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>`,
    title: "Full Observability: Prometheus, cAdvisor & Loki Logs",
    description: "Get production-grade monitoring without setting up third-party SaaS agents. Dequel collects container stats, memory usage, CPU load, network I/O, and stdout/stderr log streams in real-time.",
    highlights: [
      "cAdvisor real-time per-container CPU & RAM metrics",
      "Prometheus metric scrape target integration",
      "Grafana dashboard & Loki log aggregation",
      "Live terminal stdout stream viewer in dashboard"
    ],
    codePreview: `# Querying logs via Dequel CLI
$ dequel logs --app my-api-service --follow

[INFO] 10:45:02 [express] Server listening on port 3001
[INFO] 10:45:15 GET /api/v1/health 200 4.2ms
[METRIC] CPU: 1.2% | RAM: 42.8MB / 512MB`
  },
  {
    id: "scaling",
    label: "Auto-Scaling & Resiliency",
    icon: `<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>`,
    title: "CPU & Memory Scaling Engine",
    description: "Define auto-scaling parameters for high-traffic endpoints. Dequel's background scaling engine evaluates resource thresholds and automatically scales container replicas up or down.",
    highlights: [
      "Horizontal pod-like replica scaling based on CPU/RAM thresholds",
      "Automated health checks & container auto-healing restart policies",
      "Redis job queue integration for background worker scaling",
      "Zero-downtime rolling updates"
    ],
    codePreview: `# Scaling policy rule evaluated by Dequel API
scaling_policy:
  target_cpu_percent: 75
  min_replicas: 2
  max_replicas: 10
  cooldown_period_seconds: 60`
  }
];
---

<section class="max-w-[1150px] mx-auto px-4 py-20 dq-reveal" id="features">
  <div class="text-center mb-10">
    <div class="text-[0.65rem] font-bold uppercase tracking-[0.12em] text-[#ea580c] mb-3">Platform Capabilities</div>
    <h2 class="text-3xl md:text-5xl font-bold tracking-tight mb-4">
      Everything you need to ship.<br />
      <span class="text-[#ea580c]">Powered by your infrastructure.</span>
    </h2>
    <p class="text-sm text-[#7f7f8a] max-w-xl mx-auto leading-relaxed">
      Explore Dequel's core PaaS engines built into a single lightweight control plane.
    </p>
  </div>

  <!-- Cloudflare-style Tab Navigation Bar -->
  <div class="flex justify-center mb-12">
    <div class="cf-tab-bar" id="cf-tab-container">
      {tabs.map((tab, idx) => (
        <button
          class={`cf-tab-btn ${idx === 0 ? 'active' : ''}`}
          data-tab={tab.id}
          type="button"
        >
          <span set:html={tab.icon}></span>
          <span>{tab.label}</span>
        </button>
      ))}
    </div>
  </div>

  <!-- Tab Panels -->
  <div class="relative">
    {tabs.map((tab, idx) => (
      <div
        id={`tab-panel-${tab.id}`}
        class={`tab-panel ${idx === 0 ? 'block' : 'hidden'} transition-all duration-300`}
      >
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch border border-[#222228] bg-[#111114] rounded-2xl p-8 md:p-10 shadow-2xl">
          <!-- Left: Details -->
          <div class="lg:col-span-6 flex flex-col justify-between">
            <div>
              <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#ea580c]/10 text-[#ea580c] text-xs font-mono font-semibold mb-4">
                <span>PaaS Module:</span>
                <span class="uppercase">{tab.id}</span>
              </div>
              <h3 class="text-2xl md:text-3xl font-bold text-[#e2e2e8] mb-4">
                {tab.title}
              </h3>
              <p class="text-xs md:text-sm text-[#7f7f8a] leading-relaxed mb-6">
                {tab.description}
              </p>
              <ul class="space-y-3 mb-8">
                {tab.highlights.map((item) => (
                  <li class="flex items-start gap-3 text-xs text-[#e2e2e8]">
                    <span class="text-[#ea580c] font-bold">✓</span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
            <div>
              <a href="/docs" class="inline-flex items-center gap-2 text-xs font-bold text-[#ea580c] hover:underline">
                <span>Read technical specs for {tab.label}</span>
                <span>→</span>
              </a>
            </div>
          </div>

          <!-- Right: Code / Preview Box -->
          <div class="lg:col-span-6 border border-[#222228] bg-[#000000] rounded-xl p-5 font-mono text-xs overflow-x-auto flex flex-col justify-between">
            <div class="flex items-center justify-between border-b border-[#151519] pb-3 mb-4">
              <div class="flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-[#ea580c]"></span>
                <span class="text-[0.7rem] text-[#7f7f8a]">{tab.label} Preview</span>
              </div>
              <span class="text-[0.65rem] text-[#4b4b54]">Dequel v1.0</span>
            </div>
            <pre class="text-[#e2e2e8] leading-relaxed overflow-x-auto"><code>{tab.codePreview}</code></pre>
            <div class="mt-4 pt-3 border-t border-[#151519] text-[0.65rem] text-[#7f7f8a] flex items-center justify-between">
              <span>Status: Active</span>
              <span class="text-[#ea580c]">Zero Config Required</span>
            </div>
          </div>
        </div>
      </div>
    ))}
  </div>
</section>
