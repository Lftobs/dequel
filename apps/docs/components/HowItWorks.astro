---
---
<section class="dq-how-it-works dq-reveal py-24 max-w-[1150px] mx-auto px-4" id="how-it-works">
  <div class="text-center mb-16">
    <div class="text-[0.65rem] font-bold uppercase tracking-[0.12em] text-[#ea580c] mb-3">Engine Architecture</div>
    <h2 class="text-3xl md:text-5xl font-bold tracking-tight mb-4">
      Your own PaaS, running on <span class="text-[#ea580c]">your own servers</span>.
    </h2>
    <p class="text-sm text-[#7f7f8a] max-w-2xl mx-auto leading-relaxed">
      Dequel orchestrates raw Docker containers, Buildkit compilation, Redis job queues, SQLite data, and dynamic Caddy routing into one unified platform.
    </p>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
    <!-- Steps -->
    <div class="lg:col-span-5 space-y-6">
      <div class="group border border-[#222228] rounded-xl p-6 hover:border-[#ea580c] transition-all bg-[#111114]">
        <div class="flex items-center justify-between mb-2">
          <span class="text-xs font-mono font-bold text-[#ea580c]">STEP 01</span>
          <span class="text-[0.65rem] font-mono text-[#7f7f8a]">Debian / Ubuntu VPS</span>
        </div>
        <h3 class="text-lg font-bold mb-2 text-[#e2e2e8]">Connect Your Server</h3>
        <p class="text-xs text-[#7f7f8a] leading-relaxed">
          Run our 1-command installer. Dequel bootstraps its API control plane, Redis job queue, SQLite persistence, and cAdvisor monitoring inside a dedicated Docker network.
        </p>
      </div>

      <div class="group border border-[#222228] rounded-xl p-6 hover:border-[#ea580c] transition-all bg-[#111114]">
        <div class="flex items-center justify-between mb-2">
          <span class="text-xs font-mono font-bold text-[#ea580c]">STEP 02</span>
          <span class="text-[0.65rem] font-mono text-[#7f7f8a]">Git / ZIP / Dockerfile</span>
        </div>
        <h3 class="text-lg font-bold mb-2 text-[#e2e2e8]">Push Code & Build</h3>
        <p class="text-xs text-[#7f7f8a] leading-relaxed">
          Dequel uses Railpack to analyze your repository, autodetects your language runtime, and compiles isolated container images locally via Buildkit.
        </p>
      </div>

      <div class="group border border-[#222228] rounded-xl p-6 hover:border-[#ea580c] transition-all bg-[#111114]">
        <div class="flex items-center justify-between mb-2">
          <span class="text-xs font-mono font-bold text-[#ea580c]">STEP 03</span>
          <span class="text-[0.65rem] font-mono text-[#7f7f8a]">Caddy Proxy + Auto-SSL</span>
        </div>
        <h3 class="text-lg font-bold mb-2 text-[#e2e2e8]">Instant Auto Routing</h3>
        <p class="text-xs text-[#7f7f8a] leading-relaxed">
          The internal Caddy engine reloads dynamic routes without zero-downtime, automatically provisions Let's Encrypt certificates, and connects public traffic directly to your app.
        </p>
      </div>
    </div>

    <!-- Visual Illustrative Diagram -->
    <div class="lg:col-span-7 border border-[#222228] bg-[#000000] rounded-2xl p-6 md:p-8 relative overflow-hidden min-h-[460px] flex flex-col justify-between shadow-2xl">
      <!-- Background Grid/Scanlines -->
      <div class="absolute inset-0 opacity-10 pointer-events-none bg-[linear-gradient(rgba(234,88,12,0.15)_1px,transparent_1px),linear-gradient(90deg,rgba(234,88,12,0.15)_1px,transparent_1px)] bg-[size:24px_24px]"></div>
      
      <!-- Top header / Status bar -->
      <div class="flex items-center justify-between border-b border-[#151519] pb-4 z-10">
        <div class="flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-green-500 inline-block animate-pulse"></span>
          <span class="text-[0.65rem] font-mono tracking-wider text-[#e2e2e8]">NODE: vps-dequel-01 (ONLINE)</span>
        </div>
        <span class="text-[0.65rem] font-mono text-[#7f7f8a]">dequel-network (10.0.0.0/16)</span>
      </div>

      <!-- Diagram Body -->
      <div class="grid grid-cols-12 gap-3 my-auto relative z-10">
        <!-- Client Request / Ingress -->
        <div class="col-span-3 flex flex-col justify-center gap-3">
          <div class="border border-[#ea580c] rounded-lg p-2.5 bg-[#111114] text-center w-full relative group">
            <span class="text-[0.6rem] font-mono font-bold text-[#ea580c] block">HTTP Traffic</span>
            <div class="text-[0.55rem] text-[#7f7f8a]">app.domain.com</div>
            <div class="absolute -right-3 top-1/2 transform -translate-y-1/2 flex items-center justify-center w-4 h-4 bg-[#ea580c]/10 border border-[#ea580c]/30 rounded-full">
              <span class="w-1.5 h-1.5 bg-[#ea580c] rounded-full animate-ping absolute"></span>
              <span class="w-1.5 h-1.5 bg-[#ea580c] rounded-full"></span>
            </div>
          </div>
          <div class="border border-[#222228] rounded-lg p-2.5 bg-[#111114] text-center w-full relative">
            <span class="text-[0.6rem] font-mono font-bold text-[#e2e2e8] block">Git Webhook</span>
            <div class="text-[0.55rem] text-[#7f7f8a]">Push to main</div>
            <div class="absolute -right-3 top-1/2 transform -translate-y-1/2 flex items-center justify-center w-4 h-4 bg-[#7f7f8a]/10 border border-[#222228] rounded-full">
              <span class="w-1.5 h-1.5 bg-[#7f7f8a] rounded-full"></span>
            </div>
          </div>
        </div>

        <!-- Caddy & API Orchestrator -->
        <div class="col-span-5 flex flex-col justify-center gap-3">
          <!-- Ingress (Caddy) -->
          <div class="border border-[#222228] rounded-lg p-3 bg-[#0d0d0f] relative flex items-center justify-between">
            <div>
              <span class="text-[0.65rem] font-mono font-bold text-[#e2e2e8] block">Caddy Ingress Engine</span>
              <span class="text-[0.55rem] font-mono text-[#7f7f8a]">Auto SSL / Reverse Proxy</span>
            </div>
            <span class="text-[0.55rem] bg-[#ea580c]/10 text-[#ea580c] px-1.5 py-0.5 rounded font-mono">PORT 80/443</span>
            <div class="absolute -right-3 top-1/2 transform -translate-y-1/2 flex items-center justify-center w-4 h-4 bg-[#ea580c]/10 border border-[#ea580c]/30 rounded-full">
              <span class="w-1.5 h-1.5 bg-[#ea580c] rounded-full"></span>
            </div>
          </div>

          <!-- API Control Plane -->
          <div class="border border-[#ea580c] rounded-lg p-3 bg-[#111114] relative">
            <span class="text-[0.65rem] font-mono font-bold text-[#ea580c] block">Dequel API Orchestrator</span>
            <span class="text-[0.55rem] font-mono text-[#7f7f8a]">ElysiaJS + Bun Runtime</span>
            <div class="absolute -right-3 top-1/2 transform -translate-y-1/2 flex items-center justify-center w-4 h-4 bg-[#e2e2e8]/10 border border-[#222228] rounded-full">
              <span class="w-1.5 h-1.5 bg-[#e2e2e8] rounded-full"></span>
            </div>
          </div>
        </div>

        <!-- Deployments / Containers -->
        <div class="col-span-4 flex flex-col justify-center gap-2.5">
          <div class="border border-green-500/50 rounded-lg p-2 bg-[#0a0a0c] flex items-center justify-between">
            <div>
              <span class="text-[0.6rem] font-mono font-bold text-green-400 block">web-app-prod</span>
              <span class="text-[0.5rem] font-mono text-[#7f7f8a]">Replica #1 (Healthy)</span>
            </div>
            <span class="w-1.5 h-1.5 bg-green-500 rounded-full inline-block"></span>
          </div>

          <div class="border border-dashed border-[#ea580c]/50 rounded-lg p-2 bg-[#0a0a0c] flex items-center justify-between">
            <div>
              <span class="text-[0.6rem] font-mono font-bold text-[#ea580c] block">buildkit-daemon</span>
              <span class="text-[0.5rem] font-mono text-[#7f7f8a]">Railpack compiling...</span>
            </div>
            <span class="w-1.5 h-1.5 bg-[#ea580c] rounded-full inline-block animate-pulse"></span>
          </div>

          <div class="border border-blue-500/50 rounded-lg p-2 bg-[#0a0a0c] flex items-center justify-between">
            <div>
              <span class="text-[0.6rem] font-mono font-bold text-blue-400 block">postgres-db-1</span>
              <span class="text-[0.5rem] font-mono text-[#7f7f8a]">Mounted Data Volume</span>
            </div>
            <span class="w-1.5 h-1.5 bg-blue-500 rounded-full inline-block"></span>
          </div>
        </div>
      </div>

      <!-- Bottom Status bar -->
      <div class="flex items-center justify-between border-t border-[#151519] pt-4 z-10">
        <div class="flex gap-4">
          <span class="text-[0.6rem] font-mono text-[#4b4b54]">SQLite: ./data/dequel.db</span>
          <span class="text-[0.6rem] font-mono text-[#4b4b54]">Redis: Task Queue</span>
        </div>
        <span class="text-[0.6rem] font-mono text-[#ea580c]">Zero Infrastructure Markup</span>
      </div>
    </div>
  </div>
</section>
