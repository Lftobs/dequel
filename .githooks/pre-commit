#!/usr/bin/env bash
set -euo pipefail

# Pre-commit hook: format staged .ts/.tsx files with Biome
# Install: git config core.hooksPath .githooks

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx|json)$' || true)

if [ -z "$STAGED_FILES" ]; then
  exit 0
fi

echo "Formatting staged files with Biome..."
echo "$STAGED_FILES" | xargs ./node_modules/.bin/biome format --write --no-errors-on-unmatched 2>/dev/null || true

# Re-stage formatted files
echo "$STAGED_FILES" | xargs git add 2>/dev/null || true

echo "Biome format passed."
